#!/usr/bin/env bash
set -euo pipefail

KIT_DIR="${AI_HARNESS_KIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
INSTALL_DIR="${AI_HARNESS_HOME:-$HOME/.ai-harness}"
VERSION="0.2.0"

cmd="${1:-help}"
shift || true

usage() {
  cat <<EOF
aih $VERSION

Commands:
  doctor
  install
  init-project [--dry-run]
  sync-project [--dry-run]
  log "task"
  score "sample"
  score --draft "sample"
  version
  help
EOF
}

case "$cmd" in
  version)
    echo "$VERSION"
    ;;
  doctor)
    bash "$KIT_DIR/scripts/doctor.sh" "$@"
    ;;
  install)
    bash "$KIT_DIR/scripts/install.sh" "$@"
    ;;
  init-project)
    bash "$KIT_DIR/scripts/init-project.sh" "$@"
    ;;
  sync-project)
    bash "$KIT_DIR/scripts/sync-project.sh" "$@"
    ;;
  log)
    "$KIT_DIR/bin/ai-task-log" "$@"
    ;;
  score)
    "$KIT_DIR/bin/ai-harness-score" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
